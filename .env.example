# Copy this file to .env and fill in your real credentials.
# Get a free account at https://urs.earthdata.nasa.gov/
# NEVER commit the real .env file to git — add it to .gitignore.

EARTHDATA_USERNAME=your_username_here
EARTHDATA_PASSWORD=your_password_here

# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_claude_api_key_here

# Free, no card required: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Supabase project settings -> API. Use the service_role key (not anon) since
# this script writes data server-side, not from a browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_service_role_key_here